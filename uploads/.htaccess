Options -Indexes
# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|rb|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
